entry:
  %szp = getelementptr inbounds i8, ptr %f, i64 8
  %capp = getelementptr inbounds i8, ptr %f, i64 12
  %word0 = load i64, ptr %f, align 8
  br label %header

header:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %latch ]
  %word = phi i64 [ %word0, %entry ], [ %word.next, %latch ]
  %eltp = getelementptr inbounds i32, ptr %src, i64 %iv
  %v = load i32, ptr %eltp, align 4
  %soobit = and i64 %word, 4
  %is_soo = icmp eq i64 %soobit, 0
  %wtrunc = trunc i64 %word to i32
  %soosz = and i32 %wtrunc, 3
  %szload = load i32, ptr %szp, align 8        ; redundant along the long path
  %size = select i1 %is_soo, i32 %soosz, i32 %szload
  %capload = load i32, ptr %capp, align 4      ; redundant along the long path
  %cap = select i1 %is_soo, i32 2, i32 %capload
  %hi = and i64 %word, -8
