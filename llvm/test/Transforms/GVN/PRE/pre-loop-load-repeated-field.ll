  %new_size = add nsw i32 %size, 1
  br i1 %full, label %grow, label %nogrow, !prof !0

grow:
  call void @grow(ptr %f)
  %gcap = load i32, ptr %capp, align 4
  %gword = load i64, ptr %f, align 8
  %ghi = and i64 %gword, -8
  %gsz = load i32, ptr %szp, align 8
  br label %long

nogrow:
  br i1 %is_soo, label %soo, label %long

long:
  %lsz = phi i32 [ %gsz, %grow ], [ %szload, %nogrow ]
  %lhi = phi i64 [ %ghi, %grow ], [ %hi, %nogrow ]
  %buf = inttoptr i64 %lhi to ptr
  store i32 %new_size, ptr %szp, align 8
  %idx = sext i32 %lsz to i64
  %slot = getelementptr inbounds i32, ptr %buf, i64 %idx
  store i32 %v, ptr %slot, align 4
  %word.rl = load i64, ptr %f, align 8
  %soobit.rl = and i64 %word.rl, 4
  %notsoo = icmp ne i64 %soobit.rl, 0
  call void @llvm.assume(i1 %notsoo)
