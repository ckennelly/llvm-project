; The type test guards the vtable pointer, but the comparison is against the
; function pointer loaded from it: the load must not be moved before the check.
define i32 @vcall_function_compare(ptr %obj, i32 %x) {
; CHECK-LABEL: define i32 @vcall_function_compare(
; CHECK-SAME: ptr [[OBJ:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[VTABLE:%.*]] = load ptr, ptr [[OBJ]], align 8
; CHECK-NEXT:    [[T:%.*]] = call i1 @llvm.type.test(ptr [[VTABLE]], metadata !"_ZTS4Base")
; CHECK-NEXT:    br i1 [[T]], label %[[CONT:.*]], label %[[TRAP:.*]], !prof [[PROF2]]
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    call void @llvm.ubsantrap(i8 2)
; CHECK-NEXT:    unreachable
; CHECK:       [[CONT]]:
; CHECK-NEXT:    [[VFN:%.*]] = getelementptr inbounds ptr, ptr [[VTABLE]], i64 0
; CHECK-NEXT:    [[FN:%.*]] = load ptr, ptr [[VFN]], align 8
; CHECK-NEXT:    [[TMP0:%.*]] = icmp eq ptr [[FN]], @D1_f
; CHECK-NEXT:    br i1 [[TMP0]], label %[[IF_TRUE_DIRECT_TARG:.*]], label %[[IF_FALSE_ORIG_INDIRECT:.*]], !prof [[PROF3]]
; CHECK:       [[IF_TRUE_DIRECT_TARG]]:
; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @D1_f(ptr [[OBJ]], i32 [[X]])
; CHECK-NEXT:    br label %[[IF_END_ICP:.*]]
; CHECK:       [[IF_FALSE_ORIG_INDIRECT]]:
; CHECK-NEXT:    [[R:%.*]] = call i32 [[FN]](ptr [[OBJ]], i32 [[X]])
; CHECK-NEXT:    br label %[[IF_END_ICP]]
; CHECK:       [[IF_END_ICP]]:
; CHECK-NEXT:    [[TMP2:%.*]] = phi i32 [ [[R]], %[[IF_FALSE_ORIG_INDIRECT]] ], [ [[TMP1]], %[[IF_TRUE_DIRECT_TARG]] ]
; CHECK-NEXT:    ret i32 [[TMP2]]
;
entry:
  %vtable = load ptr, ptr %obj
  %t = call i1 @llvm.type.test(ptr %vtable, metadata !"_ZTS4Base")
  br i1 %t, label %cont, label %trap, !prof !2

trap:
  call void @llvm.ubsantrap(i8 2)
  unreachable

cont:
  %vfn = getelementptr inbounds ptr, ptr %vtable, i64 0
  %fn = load ptr, ptr %vfn
  %r = call i32 %fn(ptr %obj, i32 %x), !prof !4
  ret i32 %r
}

