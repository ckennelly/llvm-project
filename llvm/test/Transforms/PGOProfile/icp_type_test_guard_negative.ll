define i32 @callee_without_type(ptr %fp, i32 %x) {
; CHECK-LABEL: define i32 @callee_without_type(
; CHECK-SAME: ptr [[FP:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[T:%.*]] = call i1 @llvm.type.test(ptr [[FP]], metadata !"_ZTSFiiE")
; CHECK-NEXT:    br i1 [[T]], label %[[CONT:.*]], label %[[TRAP:.*]], !prof [[PROF2:![0-9]+]]
; CHECK:       [[TRAP]]:
; CHECK-NEXT:    call void @llvm.ubsantrap(i8 2)
; CHECK-NEXT:    unreachable
; CHECK:       [[CONT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = icmp eq ptr [[FP]], @f2
; CHECK-NEXT:    br i1 [[TMP0]], label %[[IF_TRUE_DIRECT_TARG:.*]], label %[[IF_FALSE_ORIG_INDIRECT:.*]], !prof [[PROF3:![0-9]+]]
; CHECK:       [[IF_TRUE_DIRECT_TARG]]:
; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @f2(i32 [[X]])
; CHECK-NEXT:    br label %[[IF_END_ICP:.*]]
; CHECK:       [[IF_FALSE_ORIG_INDIRECT]]:
; CHECK-NEXT:    [[R:%.*]] = call i32 [[FP]](i32 [[X]])
; CHECK-NEXT:    br label %[[IF_END_ICP]]
; CHECK:       [[IF_END_ICP]]:
; CHECK-NEXT:    [[TMP2:%.*]] = phi i32 [ [[R]], %[[IF_FALSE_ORIG_INDIRECT]] ], [ [[TMP1]], %[[IF_TRUE_DIRECT_TARG]] ]
; CHECK-NEXT:    ret i32 [[TMP2]]
;
entry:
  %t = call i1 @llvm.type.test(ptr %fp, metadata !"_ZTSFiiE")
  br i1 %t, label %cont, label %trap, !prof !2

trap:
  call void @llvm.ubsantrap(i8 2)
  unreachable

cont:
  %r = call i32 %fp(i32 %x), !prof !3
  ret i32 %r
}

