; A recoverable check (as with -fsanitize-cfi-cross-dso) continues to the call
; after the slow path, so the call's block has two predecessors.
define i32 @recoverable_check(ptr %fp, i32 %x) {
; CHECK-LABEL: define i32 @recoverable_check(
; CHECK-SAME: ptr [[FP:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[T:%.*]] = call i1 @llvm.type.test(ptr [[FP]], metadata !"_ZTSFiiE")
; CHECK-NEXT:    br i1 [[T]], label %[[CONT:.*]], label %[[SLOW:.*]], !prof [[PROF2]]
; CHECK:       [[SLOW]]:
; CHECK-NEXT:    call void @__cfi_slowpath(i64 1, ptr [[FP]])
; CHECK-NEXT:    br label %[[CONT]]
; CHECK:       [[CONT]]:
; CHECK-NEXT:    [[TMP0:%.*]] = icmp eq ptr [[FP]], @f1
; CHECK-NEXT:    br i1 [[TMP0]], label %[[IF_TRUE_DIRECT_TARG:.*]], label %[[IF_FALSE_ORIG_INDIRECT:.*]], !prof [[PROF3]]
; CHECK:       [[IF_TRUE_DIRECT_TARG]]:
; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @f1(i32 [[X]])
; CHECK-NEXT:    br label %[[IF_END_ICP:.*]]
; CHECK:       [[IF_FALSE_ORIG_INDIRECT]]:
; CHECK-NEXT:    [[R:%.*]] = call i32 [[FP]](i32 [[X]])
; CHECK-NEXT:    br label %[[IF_END_ICP]]
; CHECK:       [[IF_END_ICP]]:
; CHECK-NEXT:    [[TMP2:%.*]] = phi i32 [ [[R]], %[[IF_FALSE_ORIG_INDIRECT]] ], [ [[TMP1]], %[[IF_TRUE_DIRECT_TARG]] ]
; CHECK-NEXT:    ret i32 [[TMP2]]
;
entry:
  %t = call i1 @llvm.type.test(ptr %fp, metadata !"_ZTSFiiE")
  br i1 %t, label %cont, label %slow, !prof !2

slow:
  call void @__cfi_slowpath(i64 1, ptr %fp)
  br label %cont

cont:
  %r = call i32 %fp(i32 %x), !prof !1
  ret i32 %r
}

