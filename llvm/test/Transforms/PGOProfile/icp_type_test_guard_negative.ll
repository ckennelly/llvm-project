; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; Tests the cases in which ICP must not evaluate its comparison before the CFI
; type test that guards the called value.

; RUN: opt < %s -passes=pgo-icall-prom -icp-total-percent-threshold=50 -S | FileCheck %s

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define i32 @f1(i32 %x) !type !0 {
; CHECK-LABEL: define i32 @f1(
; CHECK-SAME: i32 [[X:%.*]]) !type [[META1:![0-9]+]] {
; CHECK-NEXT:    ret i32 [[X]]
;
  ret i32 %x
}

; @f2 does not carry the type, so it is not known to pass the type test.
define i32 @f2(i32 %x) {
; CHECK-LABEL: define i32 @f2(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:    ret i32 [[X]]
;
  ret i32 %x
}

define i32 @D1_f(ptr %this, i32 %x) {
; CHECK-LABEL: define i32 @D1_f(
; CHECK-SAME: ptr [[THIS:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:    ret i32 [[X]]
;
  ret i32 %x
}

@D1_vtable = constant { [3 x ptr] } { [3 x ptr] [ptr null, ptr null, ptr @D1_f] }, !type !5

declare i1 @llvm.type.test(ptr, metadata)
declare void @llvm.ubsantrap(i8)
declare void @__cfi_slowpath(i64, ptr)
declare void @use(i32)
declare i32 @__gxx_personality_v0(...)

