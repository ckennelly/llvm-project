; RUN: opt -S -passes=pgo-icall-prom < %s | FileCheck %s

; Indirect call promotion keeps the "cfi" operand bundle on both the promoted
; direct call (where it is dropped later, being vacuous) and the remaining
; indirect call, so the check follows the call it protects.

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define i32 @add1(i32 %x) !type !0 {
; CHECK-LABEL: define i32 @add1(
; CHECK-SAME: i32 [[X:%.*]]) !type [[META0:![0-9]+]] {
; CHECK-NEXT:    [[R:%.*]] = add i32 [[X]], 1
; CHECK-NEXT:    ret i32 [[R]]
;
  %r = add i32 %x, 1
  ret i32 %r
}

define i32 @call_it(ptr %f, i32 %x) {
; CHECK-LABEL: define i32 @call_it(
; CHECK-SAME: ptr [[F:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = icmp eq ptr [[F]], @add1
; CHECK-NEXT:    br i1 [[TMP1]], label %[[IF_TRUE_DIRECT_TARG:.*]], label %[[IF_FALSE_ORIG_INDIRECT:.*]], !prof [[PROF1:![0-9]+]]
; CHECK:       [[IF_TRUE_DIRECT_TARG]]:
; CHECK-NEXT:    [[TMP2:%.*]] = call i32 @add1(i32 [[X]]) [ "cfi"(metadata !"_ZTSFiiE") ]
; CHECK-NEXT:    br label %[[IF_END_ICP:.*]]
; CHECK:       [[IF_FALSE_ORIG_INDIRECT]]:
; CHECK-NEXT:    [[R:%.*]] = call i32 [[F]](i32 [[X]]) [ "cfi"(metadata !"_ZTSFiiE") ]
; CHECK-NEXT:    br label %[[IF_END_ICP]]
; CHECK:       [[IF_END_ICP]]:
; CHECK-NEXT:    [[TMP3:%.*]] = phi i32 [ [[R]], %[[IF_FALSE_ORIG_INDIRECT]] ], [ [[TMP2]], %[[IF_TRUE_DIRECT_TARG]] ]
; CHECK-NEXT:    ret i32 [[TMP3]]
;
  %r = call i32 %f(i32 %x) [ "cfi"(metadata !"_ZTSFiiE") ], !prof !1
  ret i32 %r
}

!0 = !{i64 0, !"_ZTSFiiE"}
!1 = !{!"VP", i32 0, i64 1000, i64 -8030161760475241492, i64 900}
