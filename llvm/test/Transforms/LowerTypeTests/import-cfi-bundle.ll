; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=lowertypetests -lowertypetests-summary-action=import -lowertypetests-read-summary=%S/Inputs/import-icall.yaml %s | FileCheck %s

; In the ThinLTO backend the type test that a "cfi" operand bundle stands for is
; lowered against the imported summary like any other.

target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define void @call_indirect(ptr %p) {
; CHECK-LABEL: define void @call_indirect(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = ptrtoint ptr [[P]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i64 [[TMP1]], ptrtoint (ptr @__typeid_typeid2_global_addr to i64)
; CHECK-NEXT:    br i1 [[TMP2]], label %[[BB5:.*]], label %[[BB4:.*]], !prof [[PROF0:![0-9]+]]
; CHECK:       [[BB4]]:
; CHECK-NEXT:    call void @llvm.ubsantrap(i8 2) #[[ATTR2:[0-9]+]]
; CHECK-NEXT:    unreachable
; CHECK:       [[BB5]]:
; CHECK-NEXT:    call void [[P]]()
; CHECK-NEXT:    ret void
;
  call void %p() [ "cfi"(metadata !"typeid2") ]
  ret void
}

define i8 @local_a() {
  ret i8 1
}

; The bundle on a direct call is dropped; the direct call to a jump table
; member goes to the body.
define i8 @call_direct() {
; CHECK-LABEL: define i8 @call_direct() {
; CHECK-NEXT:    [[X1:%.*]] = call i8 @local_a()
; CHECK-NEXT:    ret i8 [[X1]]
;
  %x = call i8 @local_a() [ "cfi"(metadata !"typeid2") ]
  ret i8 %x
}
;.
; CHECK: [[PROF0]] = !{!"branch_weights", i32 1048575, i32 1}
;.
