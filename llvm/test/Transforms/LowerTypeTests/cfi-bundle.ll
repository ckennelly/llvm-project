; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=lowertypetests -mtriple=x86_64-unknown-linux-gnu %s | FileCheck %s

; A "cfi" operand bundle is a type test of the called operand that traps when
; it fails. LowerTypeTests expands the bundle into an explicit llvm.type.test
; before lowering the type tests, so the check ends up as the usual jump table
; range check.

target datalayout = "e-p:64:64"

@fptr = global ptr @f

define hidden void @f() !type !0 {
  ret void
}

define hidden void @g() !type !0 {
; CHECK-LABEL: define hidden void @g(
; CHECK-SAME: ) !type [[META0:![0-9]+]] {
; CHECK-NEXT:    ret void
;
  ret void
}

declare void @h()

; An indirect call: the bundle becomes a type test that traps on failure.
define void @call_indirect(ptr %p) {
; CHECK-LABEL: define void @call_indirect(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = ptrtoint ptr [[P]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i64 [[TMP1]], ptrtoint (ptr @.cfi.jumptable to i64)
; CHECK-NEXT:    br i1 [[TMP2]], label %[[BB5:.*]], label %[[BB4:.*]], !prof [[PROF1:![0-9]+]]
; CHECK:       [[BB4]]:
; CHECK-NEXT:    call void @llvm.ubsantrap(i8 2) #[[ATTR3:[0-9]+]]
; CHECK-NEXT:    unreachable
; CHECK:       [[BB5]]:
; CHECK-NEXT:    call void [[P]]()
; CHECK-NEXT:    ret void
;
  call void %p() [ "cfi"(metadata !"typeid1") ]
  ret void
}

; A tail call stays a tail call, and the check's branch weights say the trap is
; unlikely.
define void @tail_indirect(ptr %p) {
; CHECK-LABEL: define void @tail_indirect(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = ptrtoint ptr [[P]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i64 [[TMP1]], ptrtoint (ptr @.cfi.jumptable to i64)
; CHECK-NEXT:    br i1 [[TMP2]], label %[[BB5:.*]], label %[[BB4:.*]], !prof [[PROF1]]
; CHECK:       [[BB4]]:
; CHECK-NEXT:    call void @llvm.ubsantrap(i8 2) #[[ATTR3]]
; CHECK-NEXT:    unreachable
; CHECK:       [[BB5]]:
; CHECK-NEXT:    tail call void [[P]]()
; CHECK-NEXT:    ret void
;
  tail call void %p() [ "cfi"(metadata !"typeid1") ]
  ret void
}

; A direct call cannot be redirected, so the bundle is simply dropped. The call
; then targets the function body like any other direct call.
define void @call_direct() {
; CHECK-LABEL: define void @call_direct() {
; CHECK-NEXT:    call void @f.cfi()
; CHECK-NEXT:    ret void
;
  call void @f() [ "cfi"(metadata !"typeid1") ]
  ret void
}

; Likewise for a direct call to a function that is not in any type set.
define void @call_direct_unknown() {
; CHECK-LABEL: define void @call_direct_unknown() {
; CHECK-NEXT:    call void @h()
; CHECK-NEXT:    ret void
;
  call void @h() [ "cfi"(metadata !"typeid1") ]
  ret void
}

; Other metadata on the call survives the bundle removal.
define void @call_indirect_prof(ptr %p) {
; CHECK-LABEL: define void @call_indirect_prof(
; CHECK-SAME: ptr [[P:%.*]]) {
; CHECK-NEXT:    [[TMP1:%.*]] = ptrtoint ptr [[P]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i64 [[TMP1]], ptrtoint (ptr @.cfi.jumptable to i64)
; CHECK-NEXT:    br i1 [[TMP2]], label %[[BB5:.*]], label %[[BB4:.*]], !prof [[PROF1]]
; CHECK:       [[BB4]]:
; CHECK-NEXT:    call void @llvm.ubsantrap(i8 2) #[[ATTR3]]
; CHECK-NEXT:    unreachable
; CHECK:       [[BB5]]:
; CHECK-NEXT:    call void [[P]](), !prof [[PROF2:![0-9]+]]
; CHECK-NEXT:    ret void
;
  call void %p() [ "cfi"(metadata !"typeid1") ], !prof !1
  ret void
}

!0 = !{i32 0, !"typeid1"}
!1 = !{!"VP", i32 0, i64 100, i64 -2012135647395072713, i64 100}
;.
; CHECK: [[META0]] = !{i32 0, !"typeid1"}
; CHECK: [[PROF1]] = !{!"branch_weights", i32 1048575, i32 1}
; CHECK: [[PROF2]] = !{!"VP", i32 0, i64 100, i64 -2012135647395072713, i64 100}
;.
