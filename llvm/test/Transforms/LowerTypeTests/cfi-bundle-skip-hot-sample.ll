; RUN: opt -S -passes=lowertypetests -lowertypetests-skip-hot-cfi-bundles -mtriple=x86_64-unknown-linux-gnu %s | FileCheck %s

; With a sample profile, a call site's hotness comes from its own !prof total
; (the targets the sample loader found), not from block frequencies: an
; indirect call that is hot by its value profile survived promotion and is
; left unchecked; one without a value profile keeps its check.

target datalayout = "e-p:64:64"

@fptr = global ptr @f

define hidden void @f() !type !0 {
  ret void
}

define void @hot_vp(ptr %p) !prof !1 {
; CHECK-LABEL: define void @hot_vp(
; CHECK-SAME: ptr [[P:%.*]]) !prof [[PROF15:![0-9]+]] {
; CHECK-NEXT:    call void [[P]](), !prof [[PROF16:![0-9]+]]
; CHECK-NEXT:    ret void
;
  call void %p() [ "cfi"(metadata !"typeid1") ], !prof !2
  ret void
}

define void @cold_vp(ptr %p) !prof !1 {
; CHECK-LABEL: define void @cold_vp(
; CHECK-SAME: ptr [[P:%.*]]) !prof [[PROF15]] {
; CHECK-NEXT:    [[TMP1:%.*]] = ptrtoint ptr [[P]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i64 [[TMP1]], ptrtoint (ptr @.cfi.jumptable to i64)
; CHECK-NEXT:    br i1 [[TMP2]], label %[[BB4:.*]], label %[[BB3:.*]], !prof [[PROF17:![0-9]+]]
; CHECK:       [[BB3]]:
; CHECK-NEXT:    call void @llvm.ubsantrap(i8 2) #[[ATTR3:[0-9]+]]
; CHECK-NEXT:    unreachable
; CHECK:       [[BB4]]:
; CHECK-NEXT:    call void [[P]](), !prof [[PROF18:![0-9]+]]
; CHECK-NEXT:    ret void
;
  call void %p() [ "cfi"(metadata !"typeid1") ], !prof !3
  ret void
}

; Hot function, but no value profile on the call: not provably hot.
define void @hot_fn_no_vp(ptr %p) !prof !1 {
; CHECK-LABEL: define void @hot_fn_no_vp(
; CHECK-SAME: ptr [[P:%.*]]) !prof [[PROF15]] {
; CHECK-NEXT:    [[TMP1:%.*]] = ptrtoint ptr [[P]] to i64
; CHECK-NEXT:    [[TMP2:%.*]] = icmp eq i64 [[TMP1]], ptrtoint (ptr @.cfi.jumptable to i64)
; CHECK-NEXT:    br i1 [[TMP2]], label %[[BB4:.*]], label %[[BB3:.*]], !prof [[PROF17]]
; CHECK:       [[BB3]]:
; CHECK-NEXT:    call void @llvm.ubsantrap(i8 2) #[[ATTR3]]
; CHECK-NEXT:    unreachable
; CHECK:       [[BB4]]:
; CHECK-NEXT:    call void [[P]]()
; CHECK-NEXT:    ret void
;
  call void %p() [ "cfi"(metadata !"typeid1") ]
  ret void
}

