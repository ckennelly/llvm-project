  ret i32 %r
}

define i32 @caller(i32 %x) {
; CHECK-LABEL: define i32 @caller(
; CHECK-SAME: i32 [[X:%.*]]) {
; CHECK-NEXT:    [[R_I:%.*]] = add i32 [[X]], 1
; CHECK-NEXT:    ret i32 [[R_I]]
;
  %r = call i32 @callee(i32 %x) [ "cfi"(metadata !"typeid1") ]
  ret i32 %r
}
