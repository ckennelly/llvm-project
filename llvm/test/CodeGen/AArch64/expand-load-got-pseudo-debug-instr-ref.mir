# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -run-pass=aarch64-expand-pseudo,livedebugvalues -mtriple=aarch64-unknown-linux-gnu -o - %s | FileCheck %s

# The GOT load that LOADgot expands to is referred to by a DBG_INSTR_REF.
# LiveDebugValues must still find its value.

--- |
  @g = external global i64

  define ptr @f() !dbg !4 {
    ret ptr @g, !dbg !9
  }

  !llvm.module.flags = !{!0}
  !llvm.dbg.cu = !{!1}
  !0 = !{i32 2, !"Debug Info Version", i32 3}
  !1 = distinct !DICompileUnit(language: DW_LANG_C99, file: !2, emissionKind: FullDebug)
  !2 = !DIFile(filename: "t.c", directory: "/")
  !3 = !{}
  !4 = distinct !DISubprogram(name: "f", scope: !2, file: !2, line: 1, type: !5, unit: !1, spFlags: DISPFlagDefinition, retainedNodes: !3)
  !5 = !DISubroutineType(types: !6)
  !6 = !{!7}
  !7 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !8 = !DILocalVariable(name: "p", scope: !4, file: !2, line: 1, type: !7)
  !9 = !DILocation(line: 1, scope: !4)
...
---
name:            f
tracksRegLiveness: true
debugInstrRef:   true
body:             |
  bb.0:
    ; CHECK-LABEL: name: f
    ; CHECK: BUNDLE implicit-def $x0, debug-instr-number 2 {
    ; CHECK-NEXT:   $x0 = ADRP target-flags(aarch64-page, aarch64-got) @g
    ; CHECK-NEXT:   renamable $x0 = LDRXui internal killed $x0, target-flags(aarch64-pageoff, aarch64-got, aarch64-nc) @g, debug-instr-number 1
    ; CHECK-NEXT: }
    ; CHECK-NEXT: DBG_INSTR_REF !9, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 0), debug-location !8
    ; CHECK-NEXT: DBG_VALUE_LIST !9, !DIExpression(DW_OP_LLVM_arg, 0), $x0, debug-location !8
    ; CHECK-NEXT: RET undef $lr, implicit $x0, debug-location !8
    renamable $x0 = LOADgot target-flags(aarch64-got) @g, debug-instr-number 1
    DBG_INSTR_REF !8, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 0), debug-location !9
    RET_ReallyLR implicit $x0, debug-location !9
...
